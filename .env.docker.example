# App
APP_PORT=8080
LOG_LEVEL=info
APP_NAME=stock-app

# MySQL
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=change_me_root_password
DB_NAME=stock_app
DB_USER=stock_user
