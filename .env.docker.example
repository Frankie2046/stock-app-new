# AlphaVantage
ALPHA_API_KEY=replace_with_your_alpha_api_key
ALPHA_BASE_URL=https://www.alphavantage.co/query

# Scheduler
SYNC_SYMBOLS=MSFT,AAPL,META
SYNC_CRON=0 */5 * * *
SYNC_RUN_ON_START=true
